{
  "name": "sports-stats-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:e2e": "pnpm --filter @stats/web test:e2e",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r --if-present run typecheck",
    "knip": "knip",
    "audit:deps": "pnpm audit --audit-level=high",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:quality": "node scripts/check-quality.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "^6.47.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
